# Ejemplo de variables de entorno para conexión MySQL.
# Copia estos valores a la configuración del servidor (Hostinger / .env fuera del repo).
# Database.php (Fase 0.2) usará getenv() con FALLBACK a los valores actuales:
# si no defines variables, producción no cambia.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=u633742531_Multilicores
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

