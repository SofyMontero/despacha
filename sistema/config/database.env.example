# Plantilla de sistema/config/.env.dev (copiar y completar; no se versiona).
# Usar solo una base MySQL local con datos de prueba o anonimizados.

APP_ENV=dev
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# URL local donde corre el PHP de referencia.
APP_BASE_URL=http://localhost

# Interruptor de servicios reales. Con 0 (valor por defecto) se bloquean
# las bases remotas y todo envío a WhatsApp Cloud API.
ALLOW_REAL_SERVICES=0

# Solo se leen si ALLOW_REAL_SERVICES=1. Dejar vacíos en el repositorio de migración.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
INTERNAL_API_TOKEN=
